# Local development. On the server these live in ~/yv-site/.env instead, and it
# is that file — not the image — that decides which domain a host serves.

# Where CMS content is read from. Locally point at the dashboard backend; on the
# server the container reaches it over the docker network as http://backend:8000.
API_BASE=http://localhost:8000

# Canonical origin used for metadata, sitemap.xml and robots.txt.
SITE_URL=http://localhost:3000

# Whether search engines may index this deployment. Keep false everywhere except
# the real production host — an indexed staging site duplicates the whole site
# in search results.
SITE_INDEXABLE=false

# Seconds between ISR revalidations of CMS-backed pages.
CONTENT_REVALIDATE=300
